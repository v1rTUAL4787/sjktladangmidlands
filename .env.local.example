# Supabase — create project at supabase.com, copy from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption key for IC numbers — generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-key

# WhatsApp Cloud API — from Meta Business Manager > WhatsApp > API Setup
# Dev/testing: use your personal number's test credentials
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_VERIFY_TOKEN=any-random-string-you-choose

# School info
NEXT_PUBLIC_SCHOOL_NAME="SJKT Ladang Midlands"
NEXT_PUBLIC_SCHOOL_URL=https://polylearn.my

